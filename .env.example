# ============================================
# IRON RELAY - Environment Configuration
# ============================================

# ============================================
# QUICK START FOR CONTRIBUTORS (Recommended)
# ============================================
# Get started in 2 minutes with just one API key!
# 
# 1. Copy this file: cp .env.example .env
# 2. Get your API key from: https://dapp-mvp-boilerplate.onrender.com/developer
# 3. Paste it below in IRON_RELAY_API_KEY
# 4. Run: npm install && npm run dev
# 
# That's it! You'll have real market data without needing
# Binance, Coinbase, or any other external API keys.

NODE_ENV=development

# Database Configuration
# 
# Read-Only Production Database (Recommended for Contributors)
# This gives you access to real tokens, users, and trading data
# Read-only access means you cannot modify data (safe to use!)
DATABASE_URL=postgresql://readonly_contributor:Cr0IkPFHqNZ9nULuQuKkT3qzsI5u8y8T@dpg-d84d9vj7uimc739j0lgg-a.oregon-postgres.render.com/dcsn

# Alternative: Use SQLite for quick start (no database features)
# DATABASE_URL=sqlite:./dev.db

# Alternative: Use your own PostgreSQL (for full read/write features)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Get your Iron Relay API key from the developer portal
# This gives you access to ALL pricing data (Binance, Coinbase, etc.)
IRON_RELAY_API_KEY=your_api_key_here

# Production API URL (already configured, no need to change)
PRODUCTION_API_URL=https://dapp-mvp-boilerplate.onrender.com

# ============================================
# PRODUCTION DEPLOYMENT (Advanced)
# ============================================
# Only needed if you're deploying your own production instance
# Most contributors can ignore this section

# Environment
# NODE_ENV=production

# Database (PostgreSQL for production)
# DATABASE_URL=postgresql://user:password@host:5432/database

# External API Keys (for direct API access)
# BINANCE_API_KEY=your_binance_api_key
# BINANCE_API_SECRET=your_binance_api_secret
# COINBASE_API_KEY=your_coinbase_api_key
# COINBASE_API_SECRET=your_coinbase_api_secret
# RAPID_API_KEY=your_rapidapi_key
# ONEINCH_API_KEY=your_1inch_api_key

# Admin Configuration
# ADMIN_WALLET_ADDRESS=0x...
# ADMIN_API_ACTION=ADMIN_API_KEY_MANAGEMENT
# ADMIN_TIMESTAMP_TOLERANCE_SECONDS=300

# Server Configuration
# PORT=3001
# CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Rate Limiting
# DEVELOPER_API_RATE_LIMIT_PER_MINUTE=120
# DEVELOPER_API_RATE_LIMIT_WINDOW_SECONDS=60

# Infura (for blockchain interactions)
# INFURA_PRIVATE_KEY=your_infura_key
# EVM_PRIVATE_KEY=0x...

# Settlement Network
# SETTLEMENT_NETWORK=base-sepolia

# Paper Trading Configuration
# PAPER_TRADING_USDC_MODE=transfer
# PAPER_TRADING_USDC_AMOUNT=10000
# PAPER_TRADING_USDC_DECIMALS=6
# PAPER_TRADING_ETH_DRIP_WEI=100000000000000000
# PAPER_TRADING_ETH_MIN_BALANCE_WEI=50000000000000000

# ============================================
# NOTES
# ============================================
# 
# Three Operating Modes:
# 
# 1. PROXY MODE (Recommended for Contributors)
#    - Requires: IRON_RELAY_API_KEY + Read-only DATABASE_URL
#    - Uses: Iron Relay production API for pricing data
#    - Database: Read-only access to production database
#    - Setup time: 2 minutes
#    - Features: Real tokens, users, trading data (read-only)
# 
# 2. PRODUCTION MODE (For Deployment)
#    - Requires: BINANCE_API_KEY, COINBASE_API_KEY, etc.
#    - Uses: Direct connections to external APIs
#    - Database: PostgreSQL
#    - Setup time: 30+ minutes
# 
# 3. MOCK MODE (Fallback)
#    - Requires: Nothing
#    - Uses: Cached/mock data
#    - Database: SQLite
#    - Limited functionality
# 
# For most contributors, PROXY MODE is the best choice!
